<!DOCTYPE html>
<html>
<head>
    <title>Document</title>
</head>
<body>
    <script>
      function getName(){
        return new Promise((resolve,reject)=>{
            setTimeout(()=>{
                resolve("Sano Dany")
            },600)
        })
      }

      function getId(){
        return new Promise((resolve,reject)=>{
           setTimeout(()=>{
            resolve(29271)
           },1000)
        })
      }

      function getAddress(){
        return new Promise((resolve,reject)=>{
            setTimeout(()=>{
                resolve("Gishushu")
            },800)
        })
      }
      async function getExecutionTime(){
     let startTime = performance.now()
      Promise.all([getName(),getId(),getAddress()]).then((message)=>{
        console.log("All promises resolved")
      })
      let endTimer = performance.now()
      let timer = endTimer - startTime

      console.log(timer)
    }

    getExecutionTime()
    </script>    

</body>
