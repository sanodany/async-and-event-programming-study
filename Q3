</head>
<body>
    <script>
function checkAge(age) {
    // return a Promise
return new Promise((resolve, reject)=>{
   if(age >= 18){
    resolve("You are an adult.");
   }else {
    reject("You are a minor.");
   }
})
}
checkAge(11).then((message)=>{
    console.log(message);
}).catch((error)=>{
    console.log(error);
})

</script>    

</body>
</html>
