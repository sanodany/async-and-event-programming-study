<!DOCTYPE html>
<html>
<head>
    <title>Document</title>
</head>
<body>
    <script>
        function divide(a,b, callback){
            if (b === 0){
            callback("Error: Division by zero", null);
            } else {
            callback(null, a / b);
            }
        }
        divide(10,0, function(error, result){
            if (error){
                console.log(error);
            } else {
                console.log(result);
            }
        });
    </script>    

</body>
</html>
